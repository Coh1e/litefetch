IDD_BATCH_ADD DIALOGEX 0, 0, 440, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "批量添加"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "下载地址(&U)（每行一个）:", -1, 8, 8, 424, 9
    EDITTEXT IDC_BATCH_URLS, 8, 20, 424, 88, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_TABSTOP | WS_VSCROLL
    CONTROL "", IDC_BATCH_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 114, 424, 110
    LTEXT "", IDC_BATCH_SUMMARY, 8, 230, 424, 20
    AUTOCHECKBOX "仅添加有效链接（其余不添加）(&V)", IDC_BATCH_ONLY_VALID, 8, 252, 320, 10, WS_TABSTOP
    LTEXT "统一保存到(&S):", -1, 8, 270, 200, 9
    EDITTEXT IDC_BATCH_DIR, 8, 282, 340, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览...", IDC_BATCH_BROWSE, 356, 281, 76, 16
    AUTOCHECKBOX "添加后立即开始(&I)", IDC_BATCH_AUTO_START, 8, 304, 250, 10, WS_TABSTOP
    DEFPUSHBUTTON "添加", IDOK, 268, 336, 80, 16
    PUSHBUTTON "取消", IDCANCEL, 356, 336, 80, 16
END

IDD_NEW_DOWNLOAD DIALOGEX 0, 0, 406, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建下载"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "下载地址(&U):", -1, 8, 8, 200, 9
    EDITTEXT IDC_URL, 8, 20, 390, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_TABSTOP
    LTEXT "已识别: —。", IDC_URL_HINT, 8, 64, 390, 9
    LTEXT "保存到(&S):", -1, 8, 80, 200, 9
    EDITTEXT IDC_SAVE_DIR, 8, 92, 310, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览...", IDC_BROWSE, 324, 91, 74, 16
    LTEXT "SHA-256（可选）:", -1, 8, 112, 100, 9
    EDITTEXT IDC_CHECKSUM, 110, 110, 288, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "添加后立即开始(&I)", IDC_AUTO_START, 8, 126, 200, 10, WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 246, 140, 74, 16
    PUSHBUTTON "取消", IDCANCEL, 324, 132, 74, 16
END