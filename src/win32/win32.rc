#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "assets/icons/app.ico"
IDI_NEW ICON "assets/icons/new.ico"
IDI_START ICON "assets/icons/start.ico"
IDI_PAUSE ICON "assets/icons/pause.ico"
IDI_STOP ICON "assets/icons/stop.ico"
IDI_DELETE ICON "assets/icons/delete.ico"
IDI_FOLDER ICON "assets/icons/folder.ico"
IDI_SETTINGS ICON "assets/icons/settings.ico"
IDI_START_ACTIVE ICON "assets/icons/start-active.ico"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建下载(&N)...\tCtrl+N", ID_FILE_NEW
        MENUITEM "打开种子文件(&O)...", ID_FILE_OPEN_TORRENT, GRAYED
        MENUITEM "批量添加(&B)...", ID_FILE_BATCH
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)", ID_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "全选(&A)\tCtrl+A", ID_EDIT_SELECT_ALL
        MENUITEM "查找(&F)...\tCtrl+F", ID_EDIT_FIND
        MENUITEM SEPARATOR
        MENUITEM "复制链接(&L)\tCtrl+C", ID_EDIT_COPY_LINK
        MENUITEM "复制文件路径(&P)", ID_EDIT_COPY_PATH
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "显示全部任务(&A)", ID_VIEW_FILTER_ALL
        MENUITEM "仅显示活动任务(&R)", ID_VIEW_FILTER_ACTIVE
        MENUITEM "仅显示已完成任务(&C)", ID_VIEW_FILTER_COMPLETED
        MENUITEM "仅显示失败任务(&F)", ID_VIEW_FILTER_FAILED
        MENUITEM SEPARATOR
        MENUITEM "刷新(&S)\tF5", ID_VIEW_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "显示/隐藏工具栏(&T)", ID_VIEW_TOOLBAR
        MENUITEM "显示/隐藏状态栏(&B)", ID_VIEW_STATUSBAR
        MENUITEM SEPARATOR
        MENUITEM "选择列表列(&L)...", ID_VIEW_COLUMNS
    END
    POPUP "任务(&T)"
    BEGIN
        MENUITEM "开始/继续(&S)", ID_TASK_START, GRAYED
        MENUITEM "暂停(&P)", ID_TASK_PAUSE, GRAYED
        MENUITEM "停止(&T)", ID_TASK_STOP, GRAYED
        MENUITEM "重新下载(&R)", ID_TASK_REDOWNLOAD, GRAYED
        MENUITEM "重新校验(&V)", ID_TASK_VERIFY, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "删除任务(&D)", ID_TASK_DELETE, GRAYED
        MENUITEM "删除任务及文件(&F)", ID_TASK_DELETE_FILES, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "打开文件(&O)", ID_TASK_OPEN_FILE, GRAYED
        MENUITEM "打开所在文件夹(&L)", ID_TASK_OPEN_FOLDER, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "属性(&I)...", ID_TASK_PROPERTIES, GRAYED
    END
    POPUP "工具(&O)"
    BEGIN
        MENUITEM "选项(&O)...", ID_TOOLS_OPTIONS, GRAYED
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "本版本能力说明(&C)", ID_HELP_CAPABILITIES
        MENUITEM "关于 LiteFetch(&A)", ID_HELP_ABOUT
    END
END

IDR_ACCELERATORS ACCELERATORS
BEGIN
    "N", ID_FILE_NEW, VIRTKEY, CONTROL
    "F", ID_EDIT_FIND, VIRTKEY, CONTROL
    "A", ID_EDIT_SELECT_ALL, VIRTKEY, CONTROL
    "C", ID_EDIT_COPY_LINK, VIRTKEY, CONTROL
    "V", ID_EDIT_PASTE, VIRTKEY, CONTROL
    0x74, ID_VIEW_REFRESH, VIRTKEY
END

IDD_COLUMNS DIALOGEX 0, 0, 320, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择列表列"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "勾选要显示的列；使用上移/下移调整顺序。至少需要“名称”列。", -1, 8, 8, 210, 18
    CONTROL "", IDC_COLUMN_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 28, 210, 220
    PUSHBUTTON "上移(&U)", IDC_COLUMN_UP, 226, 28, 86, 16
    PUSHBUTTON "下移(&D)", IDC_COLUMN_DOWN, 226, 48, 86, 16
    PUSHBUTTON "恢复默认(&R)", IDC_COLUMN_DEFAULT, 226, 84, 86, 16
    DEFPUSHBUTTON "确定", IDOK, 226, 248, 86, 16
    PUSHBUTTON "取消", IDCANCEL, 226, 268, 86, 16
END

IDD_DELETE_TASK DIALOGEX 0, 0, 300, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "删除任务"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DELETE_MESSAGE, 12, 12, 276, 22
    LTEXT "仅删除任务记录，不会删除已下载的文件。", -1, 12, 38, 276, 18
    LTEXT "如需同时删除文件，请使用“删除任务及文件”。", -1, 12, 56, 276, 18
    DEFPUSHBUTTON "取消", IDCANCEL, 116, 96, 80, 16
    PUSHBUTTON "删除任务", IDOK, 204, 96, 80, 16
END

IDD_OPTIONS DIALOGEX 0, 0, 420, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选项"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "下载限速（KB/s，0 表示不限）", -1, 12, 12, 200, 9
    EDITTEXT IDC_OPT_SPEED, 220, 10, 80, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "HTTP 代理（如 http://127.0.0.1:3128，留空表示直连）", -1, 12, 34, 300, 9
    EDITTEXT IDC_OPT_PROXY, 12, 46, 396, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "连接超时（秒）", -1, 12, 70, 120, 9
    EDITTEXT IDC_OPT_TIMEOUT, 140, 68, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "ed2k 服务器（每行一个 host:port）", -1, 12, 92, 300, 9
    EDITTEXT IDC_OPT_ED2K, 12, 104, 396, 90, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_TABSTOP
    LTEXT "代理与限速当前覆盖 HTTP/FTP；BT 与 ed2k 走各自的传输栈。", IDC_OPT_HINT, 12, 202, 396, 20
    DEFPUSHBUTTON "确定", IDOK, 250, 228, 74, 16
    PUSHBUTTON "取消", IDCANCEL, 334, 228, 74, 16
END

IDD_TORRENT_DETAILS DIALOGEX 0, 0, 520, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "任务属性"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_TD_TABS, "SysTabControl32", WS_TABSTOP, 8, 6, 504, 360

    LTEXT "", IDC_TD_NAME, 20, 44, 480, 14
    LTEXT "", IDC_TD_HASH, 20, 66, 480, 14
    LTEXT "", IDC_TD_STATE, 20, 88, 480, 14
    LTEXT "", IDC_TD_SIZE, 20, 110, 480, 14
    LTEXT "", IDC_TD_PATH, 20, 132, 480, 14
    LTEXT "", IDC_TD_PRIVATE, 20, 154, 480, 14

    LTEXT "", IDC_TD_DONE, 20, 44, 480, 14
    LTEXT "", IDC_TD_PROGRESS, 20, 66, 480, 14
    LTEXT "", IDC_TD_RATE, 20, 88, 480, 14
    LTEXT "", IDC_TD_UP, 20, 110, 480, 14
    LTEXT "", IDC_TD_LEFT, 20, 132, 480, 14
    LTEXT "", IDC_TD_UPLOADED, 20, 154, 480, 14
    CONTROL "完成后停止", IDC_TD_SEED_STOP, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 20, 180, 110, 14
    CONTROL "按分享率停止", IDC_TD_SEED_RATIO, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 20, 200, 110, 14
    EDITTEXT IDC_TD_RATIO_EDIT, 136, 199, 50, 15, ES_NUMBER
    LTEXT "‰（1.5 填 1500）", -1, 190, 201, 110, 12
    CONTROL "按时间停止", IDC_TD_SEED_TIME, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 20, 220, 110, 14
    EDITTEXT IDC_TD_MINUTES_EDIT, 136, 219, 50, 15, ES_NUMBER
    LTEXT "分钟", -1, 190, 221, 60, 12

    LTEXT "", IDC_TD_PEERS, 20, 44, 480, 14
    LTEXT "", IDC_TD_PROTO, 20, 66, 480, 14
    LTEXT "", IDC_TD_SEEDS, 20, 88, 480, 14
    LTEXT "", IDC_TD_NOTE, 20, 116, 480, 40

    CONTROL "", IDC_TD_FILES, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 20, 40, 480, 230
    PUSHBUTTON "跳过", IDC_TD_SKIP, 20, 276, 60, 16
    PUSHBUTTON "正常", IDC_TD_NORMAL, 86, 276, 60, 16
    PUSHBUTTON "高优先级", IDC_TD_HIGH, 152, 276, 76, 16

    CONTROL "", IDC_TD_TRACKERS, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 20, 40, 480, 190
    EDITTEXT IDC_TD_TRACKER, 20, 236, 360, 16, ES_AUTOHSCROLL
    PUSHBUTTON "添加", IDC_TD_ADD, 386, 236, 50, 16
    PUSHBUTTON "移除", IDC_TD_REMOVE, 440, 236, 60, 16

    DEFPUSHBUTTON "应用", IDC_TD_APPLY, 350, 376, 74, 18
    PUSHBUTTON "关闭", IDOK, 432, 376, 76, 18
END
