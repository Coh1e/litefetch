{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "TEMP": "${sourceDir}/.deps/tmp",
        "TMP": "${sourceDir}/.deps/tmp"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/package",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-core",
      "inherits": "windows-base",
      "cacheVariables": {
        "LITEFETCH_BUILD_QT_LEGACY": "OFF",
        "LITEFETCH_FETCH_DEPS": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-core",
      "binaryDir": "${sourceDir}/out/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LITEFETCH_BUILD_QT_LEGACY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-core",
      "configurePreset": "windows-core"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "output": {"outputOnFailure": true}
    }
  ]
}
